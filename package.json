{
  "name": "knowledgegraph-visual-learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:data && npm run test:e2e",
    "test:data": "playwright test -c playwright.data.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "kg:review:status": "node scripts/kg-review-queue.mjs status",
    "kg:review:start": "node scripts/kg-review-queue.mjs start",
    "kg:review:batch": "node scripts/kg-review-queue.mjs batch",
    "kg:review:complete": "node scripts/kg-review-queue.mjs complete",
    "kg:review:mark": "node scripts/kg-review-queue.mjs mark-reviewed",
    "kg:review:autopass": "node scripts/kg-review-queue.mjs autopass",
    "kg:review:handoff": "node scripts/kg-review-queue.mjs handoff",
    "kg:review:validate": "node scripts/kg-review-queue.mjs validate",
    "kg:review:fail": "node scripts/kg-review-queue.mjs fail"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
